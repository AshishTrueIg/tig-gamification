{
  "name": "game-engine",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky install",
    "start:workers": "node ./dist/startWorkers.js",
    "start:listeners": "node ./dist/startListeners.js",
    "start": "node ./dist/index.js",
    "babel-node": "babel-node --inspect=0.0.0.0:9229",
    "start:dev:workers": "nodemon --exec npm run babel-node -- ./startWorkers.js",
    "start:dev:listeners": "nodemon --exec npm run babel-node -- ./startListeners.js",
    "start:dev": "nodemon --exec npm run babel-node -- ./index.js",
    "lint": "standard --fix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate:undo": "sequelize db:migrate:undo",
    "db:reset": "npm run build && sequelize db:drop && sequelize db:create && sequelize db:migrate && sequelize db:seed:all",
    "db:setup": "npm run build && sequelize db:create && sequelize db:migrate && sequelize db:seed:all",
    "db:seed": "npm run build && sequelize db:seed:all",
    "db:migrate": "npm run build && sequelize db:migrate",
    "prod:db:reset": "sequelize db:drop && sequelize db:create && sequelize db:migrate && sequelize db:seed:all",
    "seed": "sequelize db:seed:all",
    "migrate": "sequelize db:migrate",
    "build": "babel . -d dist"
  },
  "repository": {
    "type": "git"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "16.13.1"
  },
  "dependencies": {
    "@bull-board/api": "3.11.0",
    "@bull-board/express": "3.11.0",
    "@socket.io/redis-adapter": "7.2.0",
    "@socket.io/redis-emitter": "4.1.1",
    "ajv": "8.8.2",
    "ajv-formats": "2.1.1",
    "ajv-i18n": "4.2.0",
    "ajv-keywords": "5.1.0",
    "axios": "^1.11.0",
    "body-parser": "1.19.1",
    "bull": "4.8.3",
    "convict": "6.2.1",
    "dayjs": "^1.11.13",
    "easytimer.js": "4.1.1",
    "ejs": "3.1.8",
    "express": "4.18.1",
    "express-basic-auth": "1.2.1",
    "flatted": "3.2.4",
    "helmet": "6.0.1",
    "http-status-codes": "2.2.0",
    "i18n": "0.15.1",
    "ioredis": "4.28.2",
    "jstat": "^1.9.6",
    "lodash": "4.17.21",
    "moment": "2.29.4",
    "morgan": "^1.10.0",
    "nodemailer": "6.7.3",
    "nodemailer-mailgun-transport": "2.1.3",
    "number-precision": "1.5.1",
    "pg": "8.7.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.12.0-beta.3",
    "sequelize-cli": "6.3.0",
    "socket.io": "4.4.1",
    "socket.io-client": "4.5.0",
    "winston": "3.3.3",
    "ws": "^8.14.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "7.16.5",
    "@babel/node": "7.16.5",
    "@babel/preset-env": "^7.28.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "10.0.0",
    "eslint": "7.12.1",
    "husky": "7.0.4",
    "lint-staged": "12.1.2",
    "nodemon": "2.0.15",
    "standard": "16.0.4"
  },
  "standard": {
    "parser": "@babel/eslint-parser",
    "env": {
      "jest": true,
      "browser": true,
      "node": true
    }
  },
  "lint-staged": {
    "src/**/*.js": [
      "npm run lint"
    ]
  }
